# ==============================
# Environnement
# ==============================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ==============================
# CORS
# ==============================
# Liste d'origines autorisées séparées par des virgules
CORS_ORIGIN=http://localhost:3000

# ==============================
# JWT
# ==============================
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ==============================
# Cookies
# ==============================
COOKIE_SECRET=change_this_cookie_secret_in_production

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ==============================
# Bcrypt
# ==============================
BCRYPT_SALT_ROUNDS=12

# ==============================
# Base de données (MongoDB / Mongoose)
# ==============================
# Développement local : privilégier 127.0.0.1 à localhost
MONGODB_URI=mongodb://127.0.0.1:27017/task_management
# Exemple MongoDB Atlas (remplacer MONGODB_URI ci-dessus en production) :
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task_management?retryWrites=true&w=majority

# ==============================
# Logs
# ==============================
LOG_LEVEL=info

# ==============================
# Application
# ==============================
APP_NAME=GuineTache

# ==============================
# SMTP (envoi d'e-mails : OTP, réinitialisation de mot de passe)
# ==============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GuineTache <no-reply@guinetache.local>

# ==============================
# OTP (code de vérification)
# ==============================
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
